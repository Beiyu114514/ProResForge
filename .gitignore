# ProResForge .gitignore

# FFmpeg 预编译产物(每个 ABI 约 30~60MB,由 scripts/build-ffmpeg-android.sh 生成)。
# 二进制(.so/.a/头文件)不入库;但 provenance 记录必须可跟踪——上线清单 B3/B4 要求
# 发布 tag 归档携带 BUILDINFO、prebuilt/README.md 与 <abi>/libraw-manifest-<abi>
# (GPL 对应源码 offer 的「pin 记录」即此三者 + scripts/build-ffmpeg-android.sh)。
app/src/main/cpp/prebuilt/*
!app/src/main/cpp/prebuilt/BUILDINFO
!app/src/main/cpp/prebuilt/README.md
!app/src/main/cpp/prebuilt/*/
app/src/main/cpp/prebuilt/*/*
!app/src/main/cpp/prebuilt/*/libraw-manifest-*

# .zcode 会话数据
.zcode/

# 构建产物:APK / AAB / 临时分发目录(体积大且不可复现,切勿提交)
*.apk
*.aab
/dist/
/tmp/

# 本地 SDK / NDK 路径(带本机绝对路径,切勿提交)
local.properties

# Gradle
.gradle/
build/
app/build/
captures/
.cxx/
.kotlin/
*.iml

# 签名(keystore / 密钥口令)一律不入库
*.jks
*.keystore
keystore.properties

# 第三方素材样本(DNG zip 等,有版权风险,切勿提交)
*.zip

# IDE / OS
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 内部开发过程、审计、验收及计划文档不入库(2026-10-11 清理 38 份过程文档后的规则)
#   * 规则一(结构性,优先):过程性文档一律放 docs/internal/(整目录忽略);
#     docs/ 顶层只放公开规范与契约(INTERFACES.md、RELEASE-SIGNING.md 等)。
#   * 规则二(兜底):docs/ 顶层已知过程文档命名家族仍被忽略,防手滑放错位置;
#     公开文件需显式 `!` 例外(见下)。新名字家族不会自动被兜底覆盖 ——
#     请放 docs/internal/,不要靠往这里加模式。
#   * 规则三:根目录历史命名家族按精确形态忽略,前导斜杠 = 仅匹配根层,
#     不影响 scripts/、app/ 等深层同名公开文档。
# ---------------------------------------------------------------------------
/docs/internal/
/CODE_REVIEW_*.md
/IMPLEMENTATION_*.md
/VERIFICATION-*.md
/verify-*.md
/FIXLOG-*.md
/AUDIT-*.md
/REVIEW-*.md
/REVIEW.md

# docs/ 顶层过程文档家族(公开例外:RELEASE-SIGNING.md 是发布操作手册,必须入库)
docs/AUDIT*.md
docs/FIXLOG*.md
docs/FIX-*.md
docs/PERF-*.md
docs/PROGRESS-*.md
docs/UI-*.md
docs/APPLELOG-*.md
docs/DNGZIP-*.md
docs/FFMPEG-*.md
docs/REVIEW*.md
docs/RELEASE-*.md
!docs/RELEASE-SIGNING.md

# 根目录构建日志(过程产物)
/*.log

# .zcode 本地工具的私有配置(若本机存在则不入库)
.zcodeignore
