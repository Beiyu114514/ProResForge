# ProResForge .gitignore

# FFmpeg 预编译产物(每个 ABI 约 30~60MB,由 scripts/build-ffmpeg-android.sh 生成)。
# 二进制(.so/.a/头文件)不入库;但 provenance 记录必须可跟踪——上线清单 B3/B4 要求
# 发布 tag 归档携带 BUILDINFO、prebuilt/README.md 与 <abi>/libraw-manifest-<abi>
# (GPL 对应源码 offer 的「pin 记录」即此三者 + scripts/build-ffmpeg-android.sh)。
app/src/main/cpp/prebuilt/*
!app/src/main/cpp/prebuilt/BUILDINFO
!app/src/main/cpp/prebuilt/README.md
!app/src/main/cpp/prebuilt/*/
app/src/main/cpp/prebuilt/*/*
!app/src/main/cpp/prebuilt/*/libraw-manifest-*

# .zcode 会话数据
.zcode/

# 构建产物:APK / AAB / 临时分发目录(体积大且不可复现,切勿提交)
*.apk
*.aab
/dist/
/tmp/

# 本地 SDK / NDK 路径(带本机绝对路径,切勿提交)
local.properties

# Gradle
.gradle/
build/
app/build/
captures/
.cxx/
.kotlin/
*.iml

# 签名(keystore / 密钥口令)一律不入库
*.jks
*.keystore
keystore.properties

# 第三方素材样本(DNG zip 等,有版权风险,切勿提交)
*.zip

# IDE / OS
.idea/
.DS_Store
Thumbs.db

# 内部开发过程、审计、验收及计划文档(公开仓库不入库)
CODE_REVIEW_*.md
IMPLEMENTATION_*.md
VERIFICATION-*.md
verify-*.md
FIXLOG-*.md
AUDIT-*.md
REVIEW-*.md
docs/*-PLAN*.md
docs/*-NOTES*.md
docs/*-RECORD*.md
docs/*-CHECKLIST*.md
docs/*-SIGNING*.md
docs/REVIEW*.md
docs/AUDIT*.md
docs/FIXLOG*.md
docs/FIX-*.md
docs/PERF-*.md
docs/PROGRESS-*.md
docs/RELEASE-*.md
docs/UI-*.md
docs/APPLELOG-*.md
docs/DNGZIP-*.md
docs/FFMPEG-*.md

# 本地工具忽略列表(与 .gitignore 双份维护,两者同步更新)
.zcodeignore
